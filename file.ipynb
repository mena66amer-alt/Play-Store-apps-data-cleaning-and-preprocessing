   "source": [
    "#Its primary purpose is to convert data from non-calculable text (such as \"15M\" or \"500k\") \n",
    "# into standardized numerical values ​​(in megabytes) in preparation for use in analysis.\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "# Function to convert the 'Size' column into a uniform numeric format (Megabytes)\n",
    "def convert_size(size):\n",
    "    if isinstance(size, str):\n",
    "        # Normalize text: convert to uppercase and remove commas\n",
    "        size = size.upper().replace(',', '') \n",
    "        \n",
    "        if 'M' in size:\n",
    "            # Extract number and treat as Megabytes\n",
    "            return float(size.replace('M', ''))\n",
    "        elif 'K' in size:\n",
    "            # Convert Kilobytes to Megabytes (Divide by 1024)\n",
    "            return float(size.replace('K', '')) / 1024\n",
    "        elif 'VARIES WITH DEVICE' in size:\n",
    "            # Mark unpredictable text as NaN for later imputation\n",
    "            return np.nan\n",
    "            \n",
    "    return np.nan\n",
    "\n",
    "# 1. Apply the transformation function to the 'Size' column\n",
    "df['Size'] = df['Size'].apply(convert_size)\n",
    "\n",
    "# 2. Impute missing values (formerly \"Varies with device\") using the Median\n",
    "# The median is used instead of the mean because it is less sensitive to outliers (extremely large apps).\n",
    "size_median = df['Size'].median()\n",
    "df['Size'] = df['Size'].fillna(size_median)\n",
    "\n",
    "# 3. Verify results\n",
    "print(\"First few rows of cleaned 'Size' column:\")\n",
    "print(df['Size'].head())\n",
    "print(f\"\\nNew Data Type: {df['Size'].dtype}\")"
   ]
