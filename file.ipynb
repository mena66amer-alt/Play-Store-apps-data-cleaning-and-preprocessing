    "import pandas as pd\n",
    "import numpy as np\n",
    "#لضمان ان البيانات نظيفة ومعالجة بدون nan \n",
    "# 1. Convert empty spaces (Strings with only spaces) to NaN formally\n",
    "# To ensure that the code will recognize and handle them\n",
    "df = df.replace(r'^\\s*$', np.nan, regex=True)\n",
    "# 2. Digital column processing (Numerical)\n",
    "numeric_cols = df.select_dtypes(include=[np.number]).columns\n",
    "df[numeric_cols] = df[numeric_cols].fillna(df[numeric_cols].median())\n",
    "\n",
    "# 3 معالجةالتواريخ العاديةخ \n",
    "\n",
    "#التواريخ العادية      الفروق الزمنيةة\n",
    "date_cols = df.select_dtypes(include=['datetime64', 'timedelta64']).columns\n",
    "for col in date_cols:\n",
    "    df[col] = df[col].fillna(df[col].min()) # يعوض بأقدم تاريخ موجود\n",
    "\n",
    "# 4. معالجة الأعمدة النصية والكائنات الأخرى (Categorical/Object)\n",
    "other_cols = df.select_dtypes(exclude=[np.number, 'datetime64', 'timedelta64']).columns\n",
    "for col in other_cols:\n",
    "    mode_res = df[col].mode()\n",
    "    if not mode_res.empty:\n",
    "        df[col] = df[col].fillna(mode_res[0])\n",
    "    else:\n",
    "        df[col] = df[col].fillna(\"Unknown\")\n",
    "\n",
    "missing_after = df.isnull().sum()\n",
    "print(missing_after[missing_after > 0] if missing_after.sum() > 0 else \"✅done \")\n",
    "df.isnull().sum()"
   ]
