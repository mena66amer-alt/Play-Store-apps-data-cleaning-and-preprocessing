    "#Identifying missing data\n",
    "df.isnull().sum()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "4bdaaa82",
   "metadata": {},
   "source": [
    "#I adopted the principle of discovering and solving the problem within the same block."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 158,
   "id": "bca13732",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "--- Rating Column Inspection Report ---\n",
      "Missing values count: 1474\n",
      "Invalid ratings count (> 5): 1\n",
      "Total anomalies: 1475\n",
      "\n",
      "Data after processing (invalid values converted to NaN):\n",
      "count    9366.000000\n",
      "mean        4.191757\n",
      "std         0.515219\n",
      "min         1.000000\n",
      "25%         4.000000\n",
      "50%         4.300000\n",
      "75%         4.500000\n",
      "max         5.000000\n",
      "Name: Rating, dtype: float64\n"
     ]
    }
   ],
   "source": [
    "#The code's objective is to address two fundamental problems in assessments:\n",
    "\n",
    "#Missing values ​​(NaN): values ​​that have not been assessed by anyone.\n",
    "\n",
    "#Outliers: such as a rating greater than 5, which is technically impossible in a five-point rating system.\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "#بعد عملية الاستكشلف الاولية نبدا هنا بالريتنج فيه نل كتير \n",
    "#الرينج نوعه رقمي \n",
    "\n",
    "\n",
    "# --- Initial Data Cleaning for 'Rating' column ---\n",
    "\n",
    "# 2. Calculate the number of missing values (NaN)\n",
    "missing_values = df['Rating'].isna().sum()\n",
    "\n",
    "# 3. Calculate the number of invalid ratings (greater than 5)\n",
    "# This usually happens due to data entry errors or row shifting\n",
    "out_of_range = (df['Rating'] > 5).sum()\n",
    "\n",
    "# 4. Display the diagnostic results\n",
    "print(f\"--- Rating Column Inspection Report ---\")\n",
    "print(f\"Missing values count: {missing_values}\")\n",
    "print(f\"Invalid ratings count (> 5): {out_of_range}\")\n",
    "print(f\"Total anomalies: {missing_values + out_of_range}\")\n",
    "\n",
    "# 5. Data Cleaning: Convert invalid values to NaN\n",
    "# We replace values > 5 with NaN to standardize all \"bad\" data for future imputation\n",
    "df.loc[df['Rating'] > 5, 'Rating'] = np.nan\n",
    "\n",
    "print(\"\\nData after processing (invalid values converted to NaN):\")\n",
    "print(df['Rating'].describe()) # Using describe() gives a better statistical summary"
   ]
  },
