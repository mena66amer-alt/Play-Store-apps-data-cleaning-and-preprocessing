    "# 1. معرفة عدد الصفوف التي تعاني من هذا الخلل قبل الحذف\n",
    "invalid_reviews = df[df['Reviews'] > df['Installs']]\n",
    "print(f\"⚠️ عدد الصفوف غير المنطقية المكتشفة: {len(invalid_reviews)}\")\n",
    "\n",
    "# 2. الاحتفاظ فقط بالصفوف المنطقية (المراجعات أقل من أو تساوي التثبيتات)\n",
    "df = df[df['Reviews'] <= df['Installs']]\n",
    "\n",
    "# 3. إعادة تشغيل الفحص للتأكد\n",
    "check_passed = (df['Reviews'] <= df['Installs']).all()\n",
    "print(f\"✅ هل تم إصلاح الخلل المنطقي؟ {check_passed}\")"
