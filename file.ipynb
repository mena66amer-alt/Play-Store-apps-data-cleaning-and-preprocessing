    "import pandas as pd\n",
    "\n",
    "df['Installs'] = df['Installs'].astype(str).str.replace('+', '').str.replace(',', '')\n",
    "df['Installs'] = pd.to_numeric(df['Installs'], errors='coerce').fillna(0)\n",
    "\n",
    "df['Price'] = df['Price'].astype(str).str.replace('$', '').str.replace(',', '')\n",
    "df['Price'] = pd.to_numeric(df['Price'], errors='coerce').fillna(0)\n",
    "\n",
    "df['Revenue'] = df['Installs'] * df['Price']\n",
    "\n",
    "def categorize_price(price):\n",
    "    if price == 0:\n",
    "        return 'Free'\n",
    "    elif price < 10:\n",
    "        return 'Cheap'\n",
    "    else:\n",
    "        return 'Expensive'\n",
    "\n",
    "df['Price_Category'] = df['Price'].apply(categorize_price)\n",
    "df = df.sort_values(by='Reviews', ascending=False)\n",
    "\n",
    "# 2. إزالة التكرارات بناءً على اسم التطبيق (App)\n",
    "df.drop_duplicates(subset='App', keep='first', inplace=True)\n",
    "\n",
    "print(f\"عدد الصفوف بعد إزالة التكرارات: {len(df)}\")\n",
    "\n",
    "# 4. حفظ البيانات المنظفة في ملف جديد\n",
    "df.to_csv('googleplaystore_final_cleaned.csv', index=False)\n",
    "\n",
    "print(\"✅ تم تحويل الأعمدة وإضافة ميزة Revenue بنجاح!\")\n",
    "print(df[['App', 'Installs', 'Price', 'Revenue']].sort_values(by='Revenue', ascending=False).head())\n",
    "df"
   ]
  },
