   "source": [
    "from sklearn.preprocessing import LabelEncoder\n",
    "\n",
    "# 1. ترميز عمود النوع (Type) باستخدام Label Encoding\n",
    "# التبرير: لأنه يحتوي على قيمتين فقط (Free/Paid)، Label Encoding سيعطينا 0 و 1، وهي أبسط طريقة.\n",
    "le = LabelEncoder()\n",
    "df['Type_Encoded'] = le.fit_transform(df['Type'].astype(str))\n",
    "\n",
    "# 2. ترميز عمود التصنيف العمري (Content Rating) باستخدام One-Hot Encoding\n",
    "# التبرير: هذا العمود يحتوي على تصنيفات قليلة (Everyone, Teen, Mature, etc.) ولا يوجد ترتيب رياضي صارم بينها، \n",
    "# لذا One-Hot Encoding يمنع الموديل من افتراض أن \"Teen\" أكبر من \"Everyone\" حسابياً.\n",
    "content_rating_dummies = pd.get_dummies(df['Content Rating'], prefix='Content')\n",
    "df = pd.concat([df, content_rating_dummies], axis=1)\n",
    "\n",
    "# 3. ترميز عمود الفئة (Category) باستخدام Label Encoding\n",
    "# التبرير: يحتوي هذا العمود على أكثر من 33 فئة مختلفة. \n",
    "# استخدام One-Hot Encoding هنا سيؤدي لإنشاء 33 عموداً جديداً (Curse of Dimensionality)، \n",
    "# مما يجعل البيانات ضخمة جداً، لذا Label Encoding هو الخيار العملي هنا.\n",
    "df['Category_Encoded'] = le.fit_transform(df['Category'].astype(str))\n",
    "\n",
    "# 4. حذف الأعمدة الأصلية (اختياري) للإبقاء على الأرقام فقط\n",
    "# df.drop(['Type', 'Content Rating', 'Category', 'Genres'], axis=1, inplace=True)\n",
    "\n",
    "print(\"✅ تمت عملية الترميز بنجاح!\")\n",
    "print(df[['Type', 'Type_Encoded', 'Content Rating', 'Category_Encoded']].head())"
   ]
  },
