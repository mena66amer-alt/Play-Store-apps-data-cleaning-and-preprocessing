    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "def run_final_quality_checks(df):\n",
    "    print(\"=\"*50)\n",
    "    print(\"🚀 تقرير فحص جودة البيانات النهائي\")\n",
    "    print(\"=\"*50)\n",
    "    \n",
    "    # الفحص الأول: القيم المفقودة\n",
    "    nulls = df.isnull().sum()\n",
    "    print(f\"\\n1️⃣ فحص القيم المفقودة:\\n{nulls[nulls > 0] if nulls.any() else '✅ البيانات مكتملة بنسبة 100%'}\")\n",
    "    \n",
    "    # الفحص الثاني: أنواع البيانات (Data Types)\n",
    "    print(f\"\\n2️⃣ فحص أنواع البيانات الأساسية:\")\n",
    "    expected_types = {'Reviews': 'int', 'Size': 'float', 'Installs': 'int', 'Price': 'float', 'Rating': 'float'}\n",
    "    for col, expected in expected_types.items():\n",
    "        actual = str(df[col].dtype)\n",
    "        status = \"✅\" if expected in actual else \"❌\"\n",
    "        print(f\" - {col}: النوع الحالي ({actual}) {status}\")\n",
    "        \n",
    "    # الفحص الثالث: التكرارات\n",
    "    duplicates = df.duplicated(subset='App').sum()\n",
    "    print(f\"\\n3️⃣ فحص التكرارات:\\n{'✅ لا يوجد تطبيقات مكررة' if duplicates == 0 else f'⚠️ تحذير: يوجد {duplicates} صف مكرر'}\")\n",
    "    \n",
    "    # الفحص الرابع: المنطق الإحصائي (Boundary Checks)\n",
    "    print(f\"\\n4️⃣ فحص الحدود المنطقية (Sanity Check):\")\n",
    "    logical_checks = [\n",
    "        (\"التقييم بين 1 و 5\", df['Rating'].between(0, 5).all()),\n",
    "        (\"الأسعار غير سالبة\", (df['Price'] >= 0).all()),\n",
    "        (\"المراجعات لا تتخطى التثبيتات\", (df['Reviews'] <= df['Installs']).all())\n",
    "    ]\n",
    "    for check_name, passed in logical_checks:\n",
    "        print(f\" - {check_name}: {'✅ صحيح' if passed else '❌ يوجد خلل منطقي'}\")\n",
    "\n",
    "# استدعاء الفحص\n",
    "run_final_quality_checks(df)"
   ]
