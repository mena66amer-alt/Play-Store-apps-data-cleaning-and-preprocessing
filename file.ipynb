      "Number of apps: 569\n",
      "Average price: $0.46\n"
     ]
    }
   ],
   "source": [
    "#Converting ratings to digital\n",
    "df['Rating'] = pd.to_numeric(df['Rating'], errors='coerce')\n",
    "\n",
    "# 2. Clean up the price column and convert it to numbers\n",
    "df['Price_numeric'] = df['Price'].apply(lambda x: float(str(x).replace('$', '').replace(',', '')) if x != '0' else 0.0)\n",
    "## 3. Filter apps rated higher than 4.7\n",
    "high_rated_apps = df[df['Rating'] > 4.7]\n",
    "\n",
    "count = len(high_rated_apps)\n",
    "avg_price = high_rated_apps['Price_numeric'].mean()\n",
    "\n",
    "print(f\"Number of apps: {count}\")\n",
    "print(f\"Average price: ${avg_price:.2f}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "f3aeddb9",
   "metadata": {},
   "source": [
    "8-What is Google’s estimated revenue from apps with 5,000,000+ installs?\n",
    "#(Assume Google takes a 30% commission from paid app sales.)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 201,
   "id": "8515a6dd",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "إجمالي مبيعات التطبيقات (5M+ تثبيت): $0.00\n",
      "إيرادات جوجل التقديرية (العمولة 30%): $0.00\n"
     ]
    }
   ],
   "source": [
    "# 1. تنظيف عمودي السعر والتثبيتات وتحويلهما إلى أرقام\n",
    "df['Price_Numeric'] = df['Price'].apply(lambda x: float(str(x).replace('$', '').replace(',', '')) if x != '0' else 0.0)\n",
    "df['Installs_Numeric'] = df['Installs'].apply(lambda x: int(str(x).replace('+', '').replace(',', '')) if '+' in str(x) else 0)\n",
    "\n",
    "# 2. تصفية التطبيقات التي تملك 5 ملايين تثبيت أو أكثر\n",
    "popular_apps = df[df['Installs_Numeric'] >= 5000000].copy()\n",
    "\n",
    "# 3. حساب إجمالي المبيعات لكل تطبيق (السعر * عدد التثبيتات)\n",
    "popular_apps['Total_Revenue'] = popular_apps['Price_Numeric'] * popular_apps['Installs_Numeric']\n",
    "\n",
    "# 4. حساب إجمالي مبيعات كل التطبيقات في هذه الفئة\n",
    "total_sales = popular_apps['Total_Revenue'].sum()\n",
    "\n",
    "# 5. حساب عمولة جوجل (30%)\n",
    "google_commission = total_sales * 0.30\n",
    "\n",
    "print(f\"إجمالي مبيعات التطبيقات (5M+ تثبيت): ${total_sales:,.2f}\")\n",
    "print(f\"إيرادات جوجل التقديرية (العمولة 30%): ${google_commission:,.2f}\")"
   ]
