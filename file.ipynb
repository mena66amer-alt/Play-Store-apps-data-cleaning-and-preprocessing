      "2246  Free             0           Teen                27\n",
      "303   Free             0       Everyone                 6\n",
      "2305  Free             0           Teen                27\n",
      "348   Free             0       Everyone                 6\n",
      "1662  Free             0   Everyone 10+                14\n"
     ]
