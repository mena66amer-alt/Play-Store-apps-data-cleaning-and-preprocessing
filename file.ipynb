    "#(Standard Normal Distribution)،or\n",
    "#MinMaxScaler: An alternative tool that compresses data so that the lowest value is 0 and the highest value is 1\n",
    "# On number columns only\n",
    "numerical_cols = ['Rating', 'Reviews', 'Size', 'Installs', 'Price']\n",
    "#We create a duplicate of the table (df) and name it df_scaled. If we make a mistake in scaling,\n",
    "#  our original data in the df remains completely safe.\n",
    "df_scaled = df.copy()\n",
    "#Here we create an \"object\" from the StandardScaler tool.\n",
    "#We use Standard Normal Distribution because it makes mathematics \"stable,\" learning \"fast,\" and results \"comparable.\"\n",
    "scaler = StandardScaler()\n",
    "#fit: يدرس البيانات الأصلية في الأعمدة المختارة، ويحسب المتوسط ($\\mu$) والانحراف المعياري ($\\sigma$) لكل عمود.\n",
    "# transform: يطبق المعادلة التالية على كل رقم:$$z = $$z = \\frac{x - \\mu}{\\sigma}$$\n",
    "df_scaled[numerical_cols] = scaler.fit_transform(df[numerical_cols])\n",
    "\n",
    "print(\"✅ تم تحجيم الميزات الرقمية بنجاح!\")\n",
    "print(df_scaled[numerical_cols].head())"
   ]
  },
